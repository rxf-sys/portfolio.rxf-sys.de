:80 {
    root * /var/www/portfolio
    file_server

    encode gzip zstd

    # Interne Pfade (Repo-Metadaten, Infrastruktur-Configs) nicht ausliefern
    @hidden path /infrastructure/* /.git/* /.github/* /_headers /CLAUDE.md
    handle @hidden {
        error 404
    }

    # Caching: HTML immer revalidieren (ETag/Last-Modified kommt vom
    # file_server); CSS/JS sind über den ?v=-Parameter in den HTML-Dateien
    # versioniert; Bilder/PDFs ändern sich selten.
    @html path / /*.html
    header @html Cache-Control "no-cache"
    @code path /index.css /index.js
    header @code Cache-Control "public, max-age=604800"
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=2592000"

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # script-src-Hash = Inline-Theme-Script im <head> der HTML-Dateien.
        # Bei Änderung des Scripts den Hash neu berechnen:
        #   echo -n '<script-inhalt>' | openssl dgst -sha256 -binary | base64
        Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-jLfxBpRRXTnnY/CZXbfHsN4T0SnAZ3h7lPwcg1eTWfE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }
}
